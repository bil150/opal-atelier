{
  "name": "opal-atelier",
  "productName": "Opal Atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Learn, simulate, research, study: studio tools for the visual arts — image study, colour mixing, 3D mannequin and glossary.",
  "author": "bil150",
  "license": "GPL-3.0-or-later",
  "homepage": "https://bil150.github.io/opal-atelier/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bil150/opal-atelier.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "npm run typecheck && vite build --config vite.web.config.mts",
    "start": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.mts",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "icons": "electron scripts/generate-icons.mjs"
  },
  "dependencies": {
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
